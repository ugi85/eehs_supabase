# Supabase Configuration
# Copy this file to .env and fill in your actual values

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sheets API Configuration (Optional - for Spreadsheet mode)
# Uncomment and fill these if you want to use Google Spreadsheet as database
# VITE_GOOGLE_SHEETS_API_KEY=your-google-api-key
# VITE_GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
